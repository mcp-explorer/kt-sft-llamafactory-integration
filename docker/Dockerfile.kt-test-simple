# Minimal kt-sft test Dockerfile - build from source
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

ARG CPU_INSTRUCT=NATIVE
ARG CUDA_ARCH="8.9"
ARG KT_VERSION=v0.5.0
ARG MAX_JOBS=16

WORKDIR /workspace

# Environment
ENV CUDA_HOME=/usr/local/cuda
ENV DEBIAN_FRONTEND=noninteractive
ENV KTRANSFORMERS_FORCE_BUILD=TRUE
ENV MAX_JOBS=${MAX_JOBS}

# Install system dependencies
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    libtbb-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libaio1 \
    libaio-dev \
    libfmt-dev \
    libgflags-dev \
    zlib1g-dev \
    patchelf \
    git \
    wget \
    vim \
    gcc \
    g++ \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    ninja \
    pyproject \
    numpy \
    cpufeature \
    aiohttp \
    zmq \
    openai \
    packaging \
    wheel \
    setuptools

# Install flash-attn with specific version
RUN pip install --no-cache-dir flash-attn==2.7.4.post1 --no-build-isolation

# Clone ktransformers repo at specific version
RUN git clone https://github.com/kvcache-ai/ktransformers.git /workspace/ktransformers && \
    cd /workspace/ktransformers && \
    git checkout ${KT_VERSION} && \
    git submodule update --init --recursive

# Work in kt-sft directory (v0.5.0 has modular structure)
WORKDIR /workspace/ktransformers/kt-sft

# Verify pyproject.toml exists
RUN ls -la pyproject.toml || (echo "ERROR: pyproject.toml not found" && exit 1)

# Patch setup.py to handle flash-attn version detection issue
RUN python -c "import re; f=open('setup.py','r'); c=f.read(); f.close(); c=c.replace('flash_version = ast.literal_eval(version_match.group(1))', 'flash_version = __import__(\"flash_attn\").__version__ if version_match is None else ast.literal_eval(version_match.group(1))'); f=open('setup.py','w'); f.write(c); f.close(); print('Patched setup.py')"

# Fix pyproject.toml license format
RUN sed -i 's/^license = "Apache-2.0"/license = {text = "Apache-2.0"}/' pyproject.toml && \
    grep -q 'license-files' pyproject.toml && sed -i '/license-files/d' pyproject.toml || true

# Build ktransformers from source
RUN CPU_INSTRUCT=${CPU_INSTRUCT} \
    USE_BALANCE_SERVE=0 \
    KTRANSFORMERS_FORCE_BUILD=TRUE \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}" \
    pip install . --no-build-isolation --verbose

# Install runtime dependencies
RUN pip install --no-cache-dir \
    transformers==4.51.3 \
    fire \
    fastapi \
    uvicorn \
    torchviz

# Create version.py
RUN echo '__version__ = "0.5.0"' > /opt/conda/lib/python3.11/site-packages/ktransformers/version.py && \
    sed -i "s|from version import __version__|from ktransformers.version import __version__|g" \
    /opt/conda/lib/python3.11/site-packages/ktransformers/__init__.py || true

WORKDIR /workspace
EXPOSE 8000
CMD ["/bin/bash"]
