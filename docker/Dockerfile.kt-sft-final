FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

ARG CUDA_ARCH=8.9

WORKDIR /workspace

# Build kt-sft
COPY kt-sft /workspace/ktransformers/kt-sft

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    ninja \
    pyproject \
    numpy \
    cpufeature \
    aiohttp \
    zmq \
    openai \
    packaging \
    wheel \
    setuptools

# Install flash-attn
RUN pip install --no-cache-dir flash-attn==2.7.4.post1 --no-build-isolation

# Clone ktransformers at v0.5.0 tag which has stable structure
ARG KT_VERSION=v0.5.0
RUN git clone https://github.com/kvcache-ai/ktransformers.git /workspace/ktransformers && \
    cd /workspace/ktransformers && \
    git checkout ${KT_VERSION} && \
    git submodule update --init --recursive

# Copy utils.py with tensor dimension fix BEFORE ktransformers build
COPY kt-sft/ktransformers/util/utils.py /workspace/ktransformers/kt-sft/ktransformers/util/utils.py

# Patch setup.py to handle flash-attn version detection issue
RUN python -c "import re; f=open('setup.py','r'); c=f.read(); f.close(); c=c.replace('flash_version = ast.literal_eval(version_match.group(1))', 'flash_version = __import__(\"flash_attn\").__version__ if version_match is None else ast.literal_eval(version_match.group(1))'); f=open('setup.py','w'); f.write(c); f.close(); print('Patched setup.py')"

# Fix pyproject.toml license format
RUN sed -i 's/^license = "Apache-2.0"/license = {text = "Apache-2.0"}/' pyproject.toml && \
    grep -q 'license-files' pyproject.toml && sed -i '/license-files/d' pyproject.toml || true

# Build and install kt-sft with CUDA
WORKDIR /workspace/ktransformers/kt-sft
RUN pip install --no-cache-dir ninja-build
RUN pip install --no-cache-dir ninja cmake packaging setuptools wheel numpy && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/torch_stable.html && \
    pip install --no-cache-dir accelerate packaging && \
    python setup.py build_ext --inplace && \
    python setup.py install

# Create version.py
RUN echo '__version__ = "0.5.0"' > /opt/conda/lib/python3.11/site-packages/ktransformers/version.py && \
    sed -i "s|from version import __version__|from ktransformers.version import __version__|g" \
    /opt/conda/lib/python3.11/site-packages/ktransformers/__init__.py || true

# Install hatchling and editables (required for LLaMA-Factory build)
RUN pip install --no-cache-dir hatchling hatch-vcs editables

# Clone and install LLaMA-Factory
RUN git clone https://github.com/hiyouga/LLaMA-Factory.git /workspace/LLaMA-Factory && \
    cd /workspace/LLaMA-Factory && \
    pip install --no-cache-dir -e ".[metrics]" --no-build-isolation && \
    pip install --no-cache-dir "transformers==4.51.3" "tokenizers>=0.21,<0.22" --no-deps

# Copy local LLaMA-Factory modifications (kt_engine.py for prompt templating, ktransformers.py for gguf_loader fix)
COPY LLaMA-Factory/src/llamafactory/chat/kt_engine.py /workspace/LLaMA-Factory/src/llamafactory/chat/kt_engine.py
COPY LLaMA-Factory/src/llamafactory/model/model_utils/ktransformers.py /workspace/LLaMA-Factory/src/llamafactory/model/model_utils/ktransformers.py

WORKDIR /workspace/LLaMA-Factory

EXPOSE 7860 8000

CMD ["/bin/bash"]
